# ANTHRYX AI - copy to .env and fill in. Never commit .env.
# Every value below ships empty or non-secret on purpose.

# --- application -----------------------------------------------------
APP_NAME=ANTHRYX AI
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- database --------------------------------------------------------
# PostgreSQL is the primary database.
DATABASE_URL=postgresql://anthryx:changeme@localhost:5432/anthryx
# Development-only fallback. Set to false in production so a missing
# PostgreSQL server fails loudly instead of silently degrading to SQLite.
ALLOW_SQLITE_FALLBACK=true
SQLITE_FALLBACK_PATH=data/anthryx_dev.db
DB_CONNECT_TIMEOUT_SECONDS=3

# --- auth ------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- CORS ------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8501,http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:8501

# --- Bhashini (M1 OCR fallback, M2 ASR + NMT) ------------------------
# Leave empty to run the clearly labelled DEMO FALLBACK provider.
# The UI distinguishes LIVE BHASHINI / BHASHINI UNAVAILABLE / DEMO FALLBACK.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_PIPELINE_URL=
BHASHINI_TIMEOUT_SECONDS=20
BHASHINI_MAX_RETRIES=2

# --- OCR -------------------------------------------------------------
TESSERACT_CMD=tesseract
# Mean OCR confidence below this escalates to the Bhashini fallback.
OCR_CONFIDENCE_THRESHOLD=70

# --- MSHA (M3) -------------------------------------------------------
# Place Mines.zip, Inspections.zip, Violations.zip, Accidents.zip and
# MinesProdYearly.zip here. No data ships with this repository.
MSHA_RAW_DIR=data/raw/msha
MSHA_PROCESSED_DIR=data/processed
